{
  "name": "@wabi1318/voice-notes",
  "version": "0.1.0",
  "description": "macOSのマイクと再生音を文字起こしし、Codexで修正・要約するターミナルアプリ",
  "license": "MIT",
  "author": "wabi1318",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wabi1318/voice-notes.git"
  },
  "homepage": "https://github.com/wabi1318/voice-notes#readme",
  "bugs": {
    "url": "https://github.com/wabi1318/voice-notes/issues"
  },
  "type": "module",
  "os": ["darwin"],
  "files": [
    "bin/voice-note",
    "native/translate.swift",
    "native/capture.swift",
    "native/capture-core.swift",
    "native/capture-info.plist",
    "src/**/*.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "voice-note": "bin/voice-note"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=26.4.0"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "bun --watch src/cli.ts",
    "audit": "bun audit",
    "check": "bun run audit && bun run typecheck && bun run test",
    "test": "bun test",
    "pack": "npm pack --ignore-scripts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.5.11"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.2"
  }
}
